{
  "name": "booking-service",
  "version": "0.1.0",
  "private": true,
  "description": "Booking Service: booking saga and booking history",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "mock-gateway": "node dev/mock-gateway.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:coverage": "node --test --test-concurrency=1 --experimental-test-coverage --test-coverage-include='src/**' test/*.test.js",
    "test:db": "./test/test-db.sh start"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  }
}
